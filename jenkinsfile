pipeline {
    agent any

    environment {
        // IP address or Private IP of your EC2 instance
        EC2_HOST    = 'YOUR_EC2_PUBLIC_OR_PRIVATE_IP' 
        // Default user for Ubuntu EC2 instances
        EC2_USER    = 'ubuntu' 
        // Folder on EC2 where project lives
        APP_DIR     = '/var/www/chatbot_project' 
        // ID of the SSH key added in Jenkins Credentials
        SSH_CRED_ID = 'ec2-ssh-key' 
    }

    stages {
        stage('Checkout') {
            steps {
                // Pulls the latest code from your main branch
                git branch: 'main', url: 'https://github.com/Ankurpdy/aichat.git'
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r req.txt
                    python manage.py test
                '''
            }
        }

        stage('Deploy to EC2 via SSH') {
            steps {
                sshagent([SSH_CRED_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} '''
                            set -e
                            cd ${APP_DIR}

                            # Pull latest changes onto the EC2 server
                            git pull origin main

                            # Activate virtual environment & install requirements
                            source venv/bin/activate
                            pip install -r req.txt

                            # Run Django management tasks
                            python manage.py migrate --noinput
                            python manage.py collectstatic --noinput

                            # Restart WSGI server and Reverse Proxy
                            sudo systemctl daemon-reload
                            sudo systemctl restart gunicorn
                            sudo systemctl restart nginx
                        '''
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}